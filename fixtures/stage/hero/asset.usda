            token outputs:surface.connect = </hero/mtl/proxy/preview.outputs:surface>

            def Shader "preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 0, 1)
                float inputs:metallic = 0
                float inputs:roughness = 1
                token outputs:surface
            }
        }
    }
    variantSet "look" = {
        "chrome" {
            over "mtl"
            {
                over "orb_std"
                {
                    over "mtlxstandard_surface"
                    {
                        custom color3f inputs:base_color = (0.95, 0.95, 0.95)
                        custom float inputs:metalness = 1
                        custom float inputs:specular_roughness = 0.04
                    }
                }
            }

        }
        "ember" {
            over "mtl"
            {
                over "orb_std"
                {
                    over "mtlxstandard_surface"
                    {
                        custom color3f inputs:base_color = (0.85, 0.25, 0.08)
                        custom float inputs:metalness = 0
                        custom float inputs:specular_roughness = 0.35
                    }
                }
            }

        }
        "gold" {
            over "mtl"
            {
                over "orb_std"
                {
                    over "mtlxstandard_surface"
                    {
                        custom color3f inputs:base_color = (1, 0.76, 0.33)
                        custom float inputs:metalness = 1
                        custom float inputs:specular_roughness = 0.18
                    }
                }
            }

        }
    }
}

